{
  "name": "heimdall-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && mkdir -p dist/swagger-assets && cp node_modules/swagger-ui-dist/swagger-ui-bundle.js node_modules/swagger-ui-dist/swagger-ui.css dist/swagger-assets/",
    "check": "tsc -b",
    "test": "vitest run --exclude \"**/*.regression.test.tsx\"",
    "test:watch": "vitest",
    "test:ci": "vitest run --exclude \"**/*.regression.test.tsx\" --reporter=default --reporter=junit --outputFile.junit=../.local/web-unit.xml",
    "test:regression": "vitest run src/*.regression.test.tsx --reporter=default --reporter=junit --outputFile.junit=../.local/web-regression.xml"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "@simplewebauthn/browser": "^13.2.2",
    "qrcode.react": "4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "swagger-ui-dist": "^5.30.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  }
}
